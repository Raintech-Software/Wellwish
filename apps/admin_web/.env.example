# Admin panel settings for LOCAL DEVELOPMENT. Copy to .env.local (git-ignored).
# The panel forwards /v1/* to the API (next.config.ts), so leave the public base URL empty.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://localhost:8000
NEXT_PUBLIC_APP_ENV=dev
# Live queue and alerts (WebSocket /ws/staff/). Empty = same host as the panel (production:
# Nginx forwards /ws/). In dev the panel (port 3000) uses the API on port 8000 by default.
NEXT_PUBLIC_WS_BASE_URL=
