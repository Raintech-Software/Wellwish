# Backend settings for LOCAL DEVELOPMENT (docker compose).
# `.\ww.ps1 up` copies this to backend/.env if it doesn't exist. Never commit backend/.env.
# Staging/production values live in the server's secret store, not in files.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-secret-change-me
DJANGO_ALLOWED_HOSTS=*

# Services (hostnames are the docker compose service names)
DATABASE_URL=postgres://wellwish:wellwish@db:5432/wellwish
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# Developer tools (dev only)
API_DOCS_ENABLED=true
ENABLE_DJANGO_ADMIN=true

# Monitoring (leave empty in dev)
SENTRY_DSN=
APP_ENV=dev

# --- Login (Phase 1) ---
# Test phone numbers: they accept OTP_TEST_CODE and no SMS is sent. Dev/staging only.
OTP_TEST_NUMBERS=+919000000001,+919000000002,+919000000003,+919000000004,+919000000005
OTP_TEST_CODE=123456
# Dev SMS: messages to other numbers go to the dev outbox (.\ww.ps1 manage sms_outbox <phone>)
SMS_BACKEND=common.sms.ConsoleSMSBackend
# Staging/prod only (MSG91 + DLT template ids). Leave empty in dev.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_LOGIN_OTP=
MSG91_TEMPLATE_PARTNER_ADDED=
MSG91_TEMPLATE_PARTNER_APPROVED=
MSG91_TEMPLATE_PARTNER_CHANGES_REQUESTED=
MSG91_TEMPLATE_PARTNER_SUSPENDED=
MSG91_TEMPLATE_PARTNER_REINSTATED=
MSG91_TEMPLATE_DOCUMENT_EXPIRED=
MSG91_TEMPLATE_BOOKING_CONFIRMED=
MSG91_TEMPLATE_BOOKING_CANCELLED=
MSG91_TEMPLATE_BOOKING_RESCHEDULED=
MSG91_TEMPLATE_BOOKING_ASSIGNED=
MSG91_TEMPLATE_BOOKING_REMINDER=
MSG91_TEMPLATE_OFFER_NEW=
MSG91_TEMPLATE_OFFER_TIME_CHANGED=
MSG91_TEMPLATE_JOB_CANCELLED=
MSG91_TEMPLATE_JOB_OTP=
MSG91_TEMPLATE_SOS_ALERT=
MSG91_TEMPLATE_TEMP_PARTNER_JOB=
# "On the way" is taken from this many hours before pickup (Phase 8; default 2)
JOB_START_BEFORE_HOURS=2
# Trip share links (Phase 8) start with this address: {SHARE_LINK_BASE_URL}/t/<token>
SHARE_LINK_BASE_URL=http://localhost:8000
# Google sign-in: OAuth client ids (Web + Android) from Google Cloud. Empty = Google button off.
GOOGLE_CLIENT_IDS=
# Separate keys in staging/prod (dev falls back to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=
OTP_HMAC_KEY=
FIELD_ENCRYPTION_KEY=

# --- Razorpay (Phase 6) ---
# Normally entered in the admin panel (Settings -> Payments). Only used if nothing is entered there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Uploads (Phase 2) ---
# Dev: files go to backend/media behind signed URLs on this API. Staging/prod: private S3 bucket
# (FILE_STORAGE=s3, FILE_S3_BUCKET required, credentials from the server's IAM role).
FILE_STORAGE=local
FILE_S3_BUCKET=
FILE_S3_REGION=ap-south-1

# --- Public pages (Phase 9B, §6.20): /legal/… and /delete-account. Empty in dev (the address
# the request came in on); required on servers, e.g. https://wellwish.in ---
PUBLIC_SITE_URL=

# Every outside key still to get (Maps, MSG91, Razorpay, Firebase…): docs/KEYS-AND-ACCOUNTS.md

# Dev admin panel user, created by .\ww.ps1 seed (dev only). 2FA is set up at first sign-in.
DEV_ADMIN_EMAIL=admin@wellwish.test
DEV_ADMIN_PASSWORD=change-me-local-dev-only
